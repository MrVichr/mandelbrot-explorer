#pragma once
#include <cstdint>
#include <cmath>

// Minimal Qt global types and functions for syntax-check compilation

typedef int64_t  qint64;
typedef uint64_t quint64;
typedef int32_t  qint32;
typedef uint32_t quint32;
typedef int16_t  qint16;
typedef uint16_t quint16;
typedef uint8_t  quint8;
typedef intptr_t qintptr;
typedef uintptr_t quintptr;

inline int qRound(double v) { return (int)std::round(v); }
inline int qRound(float v)  { return (int)std::round(v); }
inline qint64 qRound64(double v) { return (qint64)std::round(v); }

template<typename T> inline T qMin(T a, T b) { return a < b ? a : b; }
template<typename T> inline T qMax(T a, T b) { return a > b ? a : b; }
template<typename T> inline T qAbs(T a) { return a < T(0) ? -a : a; }
template<typename T> inline T qBound(T lo, T val, T hi) { return qMax(lo, qMin(val, hi)); }

inline double qSqrt(double v) { return std::sqrt(v); }

