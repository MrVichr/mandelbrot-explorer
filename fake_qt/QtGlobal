// Qt version macros
#define QT_VERSION 0x060000
#define QT_VERSION_CHECK(major, minor, patch) ((major<<16)|(minor<<8)|(patch))

// QStringLiteral — just constructs a QString from a string literal
#define QStringLiteral(s) QString(s)

// Pixel color helpers (QRgb defined here so QtGlobal is self-contained)
typedef unsigned int QRgb;
inline QRgb qRgb(int r, int g, int b) { return QRgb((0xffu << 24) | (unsigned(r) << 16) | (unsigned(g) << 8) | unsigned(b)); }
inline QRgb qRgba(int r, int g, int b, int a) { return QRgb((unsigned(a) << 24) | (unsigned(r) << 16) | (unsigned(g) << 8) | unsigned(b)); }

