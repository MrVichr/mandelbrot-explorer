#pragma once
#include "QtGlobal"
#include <string>
#include <cstdio>
#include <cstdlib>

// Minimal QChar stub
class QChar {
    char16_t c;
public:
    QChar() : c(0) {}
    QChar(char ch) : c((char16_t)ch) {}
    QChar(char16_t ch) : c(ch) {}
};

// Minimal QByteArray needed for toLocal8Bit()
class QByteArray {
    std::string d;
public:
    QByteArray() = default;
    QByteArray(const char *s) : d(s ? s : "") {}
    QByteArray(const std::string &s) : d(s) {}
    const char *constData() const { return d.c_str(); }
    const char *data() const { return d.c_str(); }
    int size() const { return (int)d.size(); }
    bool isEmpty() const { return d.empty(); }
    QByteArray &append(const char *s) { d += s; return *this; }
};

class QString {
    std::string d;
public:
    QString() = default;
    QString(const char *s) : d(s ? s : "") {}
    QString(const std::string &s) : d(s) {}

    // static constructors
    static QString number(double v, char fmt = 'g', int prec = 6) {
        char buf[64];
        if (fmt == 'f')
            std::snprintf(buf, sizeof(buf), "%.*f", prec, v);
        else
            std::snprintf(buf, sizeof(buf), "%.*g", prec, v);
        return QString(buf);
    }
    static QString number(float v, char fmt = 'g', int prec = 6) {
        return number((double)v, fmt, prec);
    }
    static QString number(__float128 v, char fmt = 'g', int prec = 6) {
        return number((double)v, fmt, prec);
    }
    static QString number(int v, int base = 10) {
        char buf[32]; std::snprintf(buf, sizeof(buf), "%d", v); return QString(buf);
    }
    static QString number(long long v, int base = 10) {
        char buf[32]; std::snprintf(buf, sizeof(buf), "%lld", v); return QString(buf);
    }
    static QString number(unsigned int v, int base = 10) {
        char buf[32]; std::snprintf(buf, sizeof(buf), "%u", v); return QString(buf);
    }
    static QString number(unsigned long long v, int base = 10) {
        char buf[32]; std::snprintf(buf, sizeof(buf), "%llu", v); return QString(buf);
    }
    static QString number(unsigned long v, int base = 10) {
        char buf[32]; std::snprintf(buf, sizeof(buf), "%lu", v); return QString(buf);
    }
    static QString fromStdString(const std::string &s) { return QString(s); }
    static QString fromLocal8Bit(const char *s) { return QString(s); }

    // .arg() chaining — stub returns *this (good enough for syntax checking)
    QString arg(const QString &, int = 0, QChar = QChar()) const { return *this; }
    QString arg(const char *s, int = 0) const { return *this; }
    QString arg(double v, int fw = 0, char fmt = 'g', int prec = -1) const { (void)v; (void)fw; (void)fmt; (void)prec; return *this; }
    QString arg(float v, int fw = 0, char fmt = 'g', int prec = -1) const { (void)v; (void)fw; (void)fmt; (void)prec; return *this; }
    QString arg(int v, int fw = 0, int base = 10, char fill = ' ') const { (void)v; (void)fw; (void)base; (void)fill; return *this; }
    QString arg(long v, int fw = 0, int base = 10, char fill = ' ') const { (void)v; return *this; }
    QString arg(long long v, int fw = 0, int base = 10, char fill = ' ') const { (void)v; return *this; }
    QString arg(unsigned int v, int fw = 0, int base = 10, char fill = ' ') const { (void)v; return *this; }
    QString arg(unsigned long long v, int fw = 0, int base = 10, char fill = ' ') const { (void)v; return *this; }

    // conversions
    QByteArray toLocal8Bit() const { return QByteArray(d); }
    QByteArray toLatin1() const { return QByteArray(d); }
    QByteArray toUtf8() const { return QByteArray(d); }
    std::string toStdString() const { return d; }
    double toDouble(bool *ok = nullptr) const {
        try { if (ok) *ok = true; return std::stod(d); }
        catch (...) { if (ok) *ok = false; return 0.0; }
    }
    int toInt(bool *ok = nullptr, int base = 10) const {
        try { if (ok) *ok = true; return std::stoi(d, nullptr, base); }
        catch (...) { if (ok) *ok = false; return 0; }
    }
    long long toLongLong(bool *ok = nullptr, int base = 10) const {
        try { if (ok) *ok = true; return std::stoll(d, nullptr, base); }
        catch (...) { if (ok) *ok = false; return 0; }
    }
    const char *toUtf8_constData() const { return d.c_str(); }

    // string operations
    bool isEmpty() const { return d.empty(); }
    bool isNull() const { return false; }
    int length() const { return (int)d.size(); }
    int size() const { return (int)d.size(); }
    QString trimmed() const { return *this; }
    QString simplified() const { return *this; }
    QString toLower() const { return *this; }
    QString toUpper() const { return *this; }
    bool startsWith(const QString &s) const { return d.find(s.d) == 0; }
    bool endsWith(const QString &s) const {
        if (d.size() < s.d.size()) return false;
        return d.rfind(s.d) == d.size() - s.d.size();
    }
    bool contains(const QString &s) const { return d.find(s.d) != std::string::npos; }
    QString &append(const QString &s) { d += s.d; return *this; }
    QString mid(int pos, int n = -1) const { return n < 0 ? QString(d.substr(pos)) : QString(d.substr(pos, n)); }
    QString left(int n) const { return QString(d.substr(0, n)); }
    QString right(int n) const { return n >= (int)d.size() ? *this : QString(d.substr(d.size() - n)); }

    QString &insert(int pos, const QString &s) { d.insert(pos, s.d); return *this; }
    QString &insert(int pos, char c) { d.insert(pos, 1, c); return *this; }

    // operators
    QString operator+(const QString &o) const { return QString(d + o.d); }
    QString &operator+=(const QString &o) { d += o.d; return *this; }
    bool operator==(const QString &o) const { return d == o.d; }
    bool operator!=(const QString &o) const { return d != o.d; }
    bool operator<(const QString &o) const { return d < o.d; }
};

inline QString operator+(const char *lhs, const QString &rhs) { return QString(lhs) + rhs; }
inline QString operator+(const QString &lhs, const char *rhs) { return lhs + QString(rhs); }
